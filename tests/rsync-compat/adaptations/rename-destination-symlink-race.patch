+#!/usr/bin/env python3
+"""Normal staged-publication rename stays beneath the destination root.
+
+This is the supported-path subset of rename-fullpath-symlink-race.  The
+upstream test uses an absolute --temp-dir to expose a mixed absolute/relative
+bug in rsync's rename wrapper.  SYQ has no --temp-dir, so this scenario keeps
+the same real parent-directory flipper and outside-write oracle while staging
+through the target's ordinary temporary-file path.
+
+Unlike upstream, every round re-arms the attack from a known state.  Upstream
+resets dest/sub by name while its flipper runs, so the reset unlinks the
+malicious symlink as soon as it lands on it, and a target that replaces a
+destination symlink with a directory when the source has a directory there
+(rsync and SYQ both do) consumes the symlink as well.  Either way the flipper
+is left swapping two ordinary directories for the rest of the budget and the
+oracle stops seeing the attack.  Here the flipper is stopped, the
+directory/symlink pair is rebuilt, and the flipper is restarted before every
+push.  The test also fails as vacuous unless at least one push published files
+into the real directory while the symlink was still present, so a pass is
+evidence that staged publication ran under a live flip.
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+import time
+
+from rsyncfns import SCRATCHDIR, race_budget, rmtree, rsync_argv, test_fail
+
+
+base = SCRATCHDIR / f'receiver-rename-{os.getpid()}'
+src = base / 'src'
+dest = base / 'dest'
+outside = base / 'outside'
+rmtree(base)
+(src / 'sub').mkdir(parents=True)
+for i in range(40):
+    (src / 'sub' / f'f{i}').write_text('payload-' + 'x' * 20000 + '\n')
+dest.mkdir()
+outside.mkdir()
+
+sub = dest / 'sub'              # the parent the attacker flips
+link = dest / '.sublink'        # a symlink -> outside, swapped in for `sub`
+scratch = dest / 'sub.flip'     # the flipper's transient third name
+names = (sub, link, scratch)
+
+
+def push():
+    return subprocess.run(
+        rsync_argv('-a', f'{src}/', f'{dest}/'),
+        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+    )
+
+
+def remove(path):
+    """Remove one name without following a symlink."""
+    if path.is_symlink() or path.is_file():
+        path.unlink()
+    elif path.is_dir():
+        shutil.rmtree(path)
+
+
+def arm():
+    """Rebuild dest/sub as an empty directory and dest/.sublink as the
+    attacker's symlink.  Only valid while no flipper is running."""
+    for name in names:
+        remove(name)
+    sub.mkdir()
+    link.symlink_to(outside)
+
+
+def real_dir():
+    """The ordinary directory among the flipped names, if any."""
+    for name in names:
+        if name.is_dir() and not name.is_symlink():
+            return name
+    return None
+
+
+# A clean run must traverse the same staged write and final-rename path.  This
+# prevents a target that simply rejects the invocation from passing the race.
+arm()
+control = push()
+if control.returncode != 0 or not (sub / 'f0').is_file():
+    test_fail(
+        "positive control: an ordinary staged copy did not create dest/sub/f0 "
+        f"(rc={control.returncode}); the rename-race test would be vacuous"
+    )
+for entry in outside.iterdir():
+    remove(entry)
+
+# Keep dest/sub alternating between the real directory and a symlink to the
+# outside sentinel directory while a transfer stages and publishes files.  The
+# swap is upstream's 3-rename dance through a scratch name.  The child reports
+# readiness on stdout so the push starts under a running flipper, terminates
+# with this test process, and has a hard backstop so an interrupted suite
+# cannot leave a namespace-mutating process behind.
+flip_code = (
+    "import os, sys, time\n"
+    "sub, link = sys.argv[1], sys.argv[2]\n"
+    "scratch = sub + '.flip'\n"
+    "parent = os.getppid()\n"
+    "deadline = time.monotonic() + 120\n"
+    "print('ready', flush=True)\n"
+    "while time.monotonic() < deadline and os.getppid() == parent:\n"
+    "    try:\n"
+    "        os.makedirs(sub, exist_ok=True)\n"
+    "        os.rename(sub, scratch); os.rename(link, sub); os.rename(scratch, link)\n"
+    "        os.rename(sub, scratch); os.rename(link, sub); os.rename(scratch, link)\n"
+    "    except OSError:\n"
+    "        pass\n"
+)
+
+
+def stop_flipper(flip):
+    flip.terminate()
+    try:
+        flip.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        flip.kill()
+        flip.wait()
+    flip.stdout.close()
+
+
+def start_flipper():
+    flip = subprocess.Popen(
+        [sys.executable, '-c', flip_code, str(sub), str(link)],
+        stdout=subprocess.PIPE, text=True,
+    )
+    if flip.stdout.readline().strip() != 'ready':
+        stop_flipper(flip)
+        test_fail("the destination parent flipper did not start")
+    return flip
+
+
+rounds = armed = productive = 0
+deadline = time.monotonic() + race_budget(10.0)
+while time.monotonic() < deadline:
+    rounds += 1
+    arm()
+    flip = start_flipper()
+    try:
+        push()
+    finally:
+        stop_flipper(flip)
+    escaped = sorted(entry.name for entry in outside.iterdir())
+    if escaped:
+        test_fail(
+            "receiver publication followed a raced destination parent "
+            f"symlink and wrote outside the selected tree: {escaped}"
+        )
+    # With the flipper stopped this is a consistent view of the three names.
+    # A round counts as armed when the target never consumed the symlink, and
+    # as productive when it also published payload into the real directory
+    # under that live flip.
+    if any(name.is_symlink() for name in names):
+        armed += 1
+        real = real_dir()
+        if real is not None and any((real / f'f{i}').is_file() for i in range(40)):
+            productive += 1
+
+if productive == 0:
+    test_fail(
+        f"vacuous race: {rounds} rounds, {armed} of them with the attacker's "
+        "symlink still present after the push, but no push published a file "
+        "into the real directory while the symlink was live"
+    )
+
+print(
+    "receiver-rename-symlink-race: publication stayed beneath destination root "
+    f"({rounds} rounds, {armed} armed, {productive} productive)"
+)
